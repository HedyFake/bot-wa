# Copy to .env on the server. Never commit .env.
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id-ID

DATABASE_URL=postgresql://nursing_bot:change_me@localhost:5432/nursing_class_a
REDIS_URL=redis://localhost:6379

# NVIDIA hosted API — create a NEW key after revoking any key exposed in chat.
NVIDIA_API_KEY=replace_with_new_rotated_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_SUPER_VL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_LIGHTNING=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_MODE=auto
NVIDIA_TIMEOUT_MS=60000
NVIDIA_MAX_RETRIES=1

# Set exact JID during secure setup. Do not guess or use display name.
ADMIN_WHATSAPP_JID=replace_with_admin_jid@s.whatsapp.net
ADMIN_BOOTSTRAP_SECRET_HASH=configure_argon2id_hash_out_of_band
ADMIN_BOOTSTRAP_EXPIRES_AT=configure_iso_timestamp

WHATSAPP_PROVIDER=mock
WHATSAPP_AUTH_DIR=/var/lib/nursing-class-assistant/whatsapp-auth
WHATSAPP_SESSION_ENCRYPTION_KEY=generate_32_byte_secret
WHATSAPP_ALLOW_EXPERIMENTAL_BAILEYS=false
WHATSAPP_PRIMARY_GROUP_JID=configure_after_group_registration@g.us

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=nursing-class-materials
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

LOG_LEVEL=info
LOG_REDACT_FIELDS=authorization,apiKey,password,token,session,creds
MESSAGE_RAW_RETENTION_DAYS=7
MEDIA_MAX_MB=25
OUTBOUND_ENABLED=false
