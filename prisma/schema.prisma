// HdyBot — skema database utama (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  USER_PROVIDED_PENDING_CONFIRMATION
  VERIFIED
  REJECTED
  REFERENCE_TO_CHECK
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MessageCategory {
  URGENT
  IMPORTANT
  NORMAL
  LOW
  REVIEW
}

model User {
  id          String     @id @default(uuid())
  e164        String?    @unique
  jid         String?    @unique
  displayName String?
  email       String?
  createdAt   DateTime   @default(now())
  roles       UserRole[]
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // owner, admin, ketua, sekretaris, bendahara, wali_kelas, member
  label       String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model UserRole {
  userId  String
  roleId  String
  classId String?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Class {
  id           String             @id @default(uuid())
  name         String             @unique
  semester     String
  academicYear String?
  timezone     String             @default("Asia/Jakarta")
  sourceStatus VerificationStatus
  courses      Course[]
  schedules    Schedule[]
  groups       Group[]
}

model Group {
  id          String        @id @default(uuid())
  jid         String        @unique
  name        String
  classId     String?
  class       Class?        @relation(fields: [classId], references: [id])
  isPrimary   Boolean       @default(false)
  verified    Boolean       @default(false)
  outboundAllowed Boolean   @default(false)
  createdAt   DateTime      @default(now())
  sources     GroupSource[]
}

model GroupSource {
  id              String   @id @default(uuid())
  groupId         String   @unique
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(false)
  paused          Boolean  @default(false)
  consentNoted    Boolean  @default(false)
  reliability     String   @default("member") // official, officer, member
  categoryFilter  String[] @default([])
  createdAt       DateTime @default(now())
}

model Course {
  id             String             @id @default(uuid())
  classId        String
  class          Class              @relation(fields: [classId], references: [id])
  code           String
  originalName   String
  normalizedName String
  creditsSks     Int
  aliases        String[]
  sourceStatus   VerificationStatus
  lecturers      CourseLecturer[]
  schedules      Schedule[]

  @@unique([classId, code])
}

model Lecturer {
  id                 String             @id @default(uuid())
  originalName       String             @unique
  normalizedName     String?
  verificationStatus VerificationStatus
  courses            CourseLecturer[]
}

model CourseLecturer {
  courseId              String
  lecturerId            String
  assignsToEverySession Boolean            @default(false)
  verificationStatus    VerificationStatus
  course                Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer              Lecturer           @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@id([courseId, lecturerId])
}

model Schedule {
  id           String              @id @default(uuid())
  classId      String
  class        Class               @relation(fields: [classId], references: [id])
  courseId     String
  course       Course              @relation(fields: [courseId], references: [id])
  weekday      Weekday
  startTime    String // HH:mm, Asia/Jakarta
  endTime      String
  room         String?
  sourceStatus VerificationStatus
  exceptions   ScheduleException[]

  @@unique([classId, weekday, startTime])
}

model ScheduleException {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD (Asia/Jakarta)
  kind       String // cancelled, moved, room_changed
  newStart   String?
  newEnd     String?
  newRoom    String?
  note       String?
  approvedBy String?
  createdAt  DateTime @default(now())

  @@unique([scheduleId, date])
}

model Assignment {
  id          String    @id @default(uuid())
  classId     String
  courseId    String?
  title       String
  description String?
  kind        String    @default("assignment") // assignment, presentation, practicum, uts, uas, quiz, seminar, paper, picket, meeting, custom
  dueAt       DateTime
  status      String    @default("open")
  sourceRef   String?
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model Reminder {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  targetJid      String
  text           String
  fireAt         DateTime
  status         String    @default("scheduled") // scheduled, sent, cancelled, failed, dead
  attempts       Int       @default(0)
  refType        String?
  refId          String?
  paused         Boolean   @default(false)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, fireAt])
}

model Announcement {
  id              String    @id @default(uuid())
  targetGroupJid  String
  text            String
  status          String    @default("draft") // draft, pending_approval, approved, rejected, sent, failed
  sourceReviewId  String?
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  providerMsgId   String?
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
}

model Material {
  id         String   @id @default(uuid())
  courseId   String?
  title      String
  url        String?
  documentId String?
  sourceUrl  String?
  fetchedAt  DateTime?
  verification VerificationStatus @default(REFERENCE_TO_CHECK)
  createdAt  DateTime @default(now())
}

model InboxMessage {
  id                String             @id @default(uuid())
  providerMessageId String
  chatJid           String
  senderJid         String
  text              String
  quotedMessageId   String?
  isForwarded       Boolean            @default(false)
  receivedAt        DateTime
  createdAt         DateTime           @default(now())
  classifications   AiClassification[]

  @@unique([chatJid, providerMessageId])
}

model AiClassification {
  id                   String          @id @default(uuid())
  inboxMessageId       String
  inboxMessage         InboxMessage    @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)
  category             MessageCategory
  confidence           Float
  topic                String
  summary              String
  extractedFacts       Json
  requiresConfirmation Boolean
  recommendedAction    String
  model                String?
  createdAt            DateTime        @default(now())
}

model ReviewQueue {
  id               String    @id @default(uuid())
  classificationId String?
  kind             String
  payload          Json
  status           String    @default("pending_review") // pending_review, approved, rejected
  decidedBy        String?
  decidedAt        DateTime?
  reason           String?
  createdAt        DateTime  @default(now())
}

model Document {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  sizeBytes Int
  sha256    String   @unique
  storageKey String
  uploadedBy String?
  createdAt DateTime @default(now())
}

model ModelUsage {
  id               String   @id @default(uuid())
  alias            String
  modelId          String
  task             String
  routeReason      String
  latencyMs        Int
  promptTokens     Int?
  completionTokens Int?
  status           String
  errorCode        String?
  createdAt        DateTime @default(now())
}

/// Append-only: aplikasi tidak pernah UPDATE/DELETE (ditegakkan oleh trigger di migration).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actor     String
  action    String
  target    String?
  payload   Json?
  result    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BotSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}
