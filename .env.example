# Salin ke .env (JANGAN commit .env). Isi nilai rahasia hanya secara lokal.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Identitas (Nomor Admin = 082233038659; Nomor Bot = bebas/random, bisa ganti-ganti lewat QR Code)
BOT_NAME=HdyBot
BOT_DISPLAY_NAME="HdyBot — Nursing Class A Assistant"
OWNER_NAME=Hedy
OWNER_WHATSAPP=+6282233038659
OWNER_EMAIL=wibyjoe12@gmail.com
ADMIN_WHATSAPP_ALLOWLIST=+6282233038659
ADMIN_PASSWORD=
ADMIN_REQUIRE_PASSWORD=true
CLASS_NAME="Nursing Class A"
TIMEZONE=Asia/Jakarta
APP_LOCALE=id-ID

# Database & queue
DATABASE_URL=postgresql://hdybot:change_me@localhost:5432/hdybot
REDIS_URL=redis://localhost:6379

# NVIDIA (buat key BARU; key lama yang pernah ditempel di chat wajib di-revoke)
OPENAI_API_KEY=
AI_PROVIDER_SWITCH_MS=3500
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_SUPER_VL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_MODEL_LIGHTNING=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_MS=60000
AI_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_ROUTER_MODE=auto
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=2

# WhatsApp (wwebjs = tampilkan QR code di terminal via whatsapp-web.js + qrcode-terminal)
WHATSAPP_PROVIDER=wwebjs
WHATSAPP_AUTH_DIR=./whatsapp-auth
# Opsional: isi dengan nomor WA Bot (contoh: 081234567890) jika ingin menautkan dengan Kode Pairing 8-Digit tanpa scan kamera
WHATSAPP_PAIRING_PHONE=
WHATSAPP_ALLOW_EXPERIMENTAL_BAILEYS=false
WHATSAPP_PRIMARY_GROUP_JID=
OUTBOUND_ENABLED=true
DRY_RUN=false

# Retensi
MESSAGE_RAW_RETENTION_DAYS=7
MEDIA_MAX_MB=25

GOOGLE_DRIVE_FOLDER_ID=1mMDceZROeLNxlxonHy9obtGKxSzGHIVy
GOOGLE_DRIVE_AUTH_MODE=service_account
GOOGLE_APPLICATION_CREDENTIALS=
# JID chat yang disetujui pemilik untuk menerima seluruh isi folder.
GOOGLE_DRIVE_ALLOWED_CHATS=

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Direktori khusus MP3 yang pemilik izinkan untuk dikirim lewat WhatsApp.
MUSIC_LIBRARY_DIR=
